// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model School {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  events    ScheduleEvent[]
  matches   Match[]
  talents   Talent[]
  teams     Team[]
  gallery   GalleryImage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Team {
  id           String             @id @default(cuid())
  name         String
  course       String?
  logoUrl      String?
  color        String             @default("#bc2a24")
  points       Int                @default(0)
  wins         Int                @default(0)
  losses       Int                @default(0)
  draws        Int                @default(0)
  players      Player[]
  teamAMatches Match[]            @relation("TeamA")
  teamBMatches Match[]            @relation("TeamB")
  groupId      String?
  group        Group?             @relation(fields: [groupId], references: [id])
  tournamentId String?
  tournament   Tournament?        @relation(fields: [tournamentId], references: [id])
  leaderboard  LeaderboardEntry[]
  schoolId     String?
  school       School?            @relation(fields: [schoolId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Player {
  id        String   @id @default(cuid())
  name      String
  number    Int?
  position  String?
  avatarUrl String?
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tournament {
  id        String           @id @default(cuid())
  name      String
  sport     String
  mode      TournamentMode   @default(FUTSAL)
  status    TournamentStatus @default(UPCOMING)
  groups    Group[]
  matches   Match[]
  teams     Team[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Group {
  id           String     @id @default(cuid())
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]
  createdAt    DateTime   @default(now())
}

model Match {
  id                   String      @id @default(cuid())
  tournamentId         String
  tournament           Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamAId              String
  teamA                Team        @relation("TeamA", fields: [teamAId], references: [id])
  teamBId              String
  teamB                Team        @relation("TeamB", fields: [teamBId], references: [id])
  teamAScore           Int?
  teamBScore           Int?
  status               MatchStatus @default(SCHEDULED)
  phase                String      @default("INITIAL_STAGE")
  leg                  Int?
  winnerTeamId         String?
  walkoverWinnerTeamId String?
  scheduledAt          DateTime?
  location             String?
  notes                String?
  schoolId             String?
  school               School?     @relation(fields: [schoolId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model ScheduleEvent {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        EventType @default(OTHER)
  startTime   DateTime
  endTime     DateTime?
  venue       String?
  day         Int       @default(1)
  featured    Boolean   @default(false)
  imageUrl    String?
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamName  String
  course    String?
  points    Int      @default(0)
  rank      Int
  change    Int      @default(0)
  category  String   @default("overall")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, category])
}

model Talent {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  type        String
  imageUrl    String?
  performAt   DateTime?
  venue       String?
  featured    Boolean   @default(false)
  socialLinks Json?
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryImage {
  id         String   @id @default(cuid())
  url        String
  caption    String?
  uploadedAt DateTime @default(now())
  featured   Boolean  @default(false)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id])
}

model CourseVote {
  id        String   @id @default(cuid())
  courseId  String
  userId    String?  @unique
  ip        String?
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum TournamentMode {
  FUTSAL
  VOLLEY
}

enum TournamentStatus {
  UPCOMING
  GROUP_STAGE
  KNOCKOUT
  FINISHED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  WALKOVER
}

enum EventType {
  TOURNAMENT
  CONCERT
  GAME
  SHOWCASE
  CEREMONY
  OTHER
}
